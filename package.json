{
  "name": "fm-receiving",
  "version": "0.1.0",
  "private": true,
  "description": "FM Receiving — Penerimaan, Prepasteurisasi, Transfer & Monitoring Susu Segar (CMD1 Plant Sentul 1)",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "test:watch": "npm run test:watch --workspace=server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:reset": "npm run db:reset --workspace=server",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "globals": "^15.12.0"
  },
  "engines": {
    "node": ">=20"
  }
}
