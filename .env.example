# ============================================================
# FM Receiving — contoh konfigurasi
# Salin ke .env lalu sesuaikan. JANGAN commit .env.
# ============================================================

# --- Aplikasi ---
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# --- MySQL ---
# Saat memakai Docker Compose, DB_HOST adalah nama service: mysql
DB_HOST=localhost
DB_PORT=3307
# Port host untuk container MySQL (di dalam Docker tetap 3306).
# Diubah ke 3307 karena 3306 sudah dipakai instalasi MySQL lain di mesin ini.
DB_HOST_PORT=3307
DB_NAME=fm_receiving
DB_USER=fm_app
DB_PASSWORD=ganti_password_ini
DB_CONNECTION_LIMIT=10
DB_COLLATION=utf8mb4_unicode_ci
DB_SSL=false
# Opsional: CA PEM satu baris dengan karakter \n untuk verifikasi sertifikat database.
DB_SSL_CA=

# Root password MySQL (dipakai container saat inisialisasi)
MYSQL_ROOT_PASSWORD=ganti_root_password_ini

# --- Auth ---
# Bangkitkan dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_panjang
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SESSION_IDLE_TIMEOUT_HOURS=8

# Kebijakan PIN (FR-1.5)
PIN_MIN_LENGTH=6
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Waktu (NFR-14) ---
# Seluruh timestamp disimpan UTC. TZ dipakai untuk tampilan & export.
APP_TIMEZONE=Asia/Jakarta
CLOCK_DRIFT_WARN_SECONDS=5

# --- Export ---
EXPORT_OUTPUT_DIR=./export-output
EXPORT_DAILY_CRON=0 6 * * *

# --- Log ---
LOG_LEVEL=info
LOG_DIR=./logs
